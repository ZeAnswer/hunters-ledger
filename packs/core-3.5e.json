      "source": "class",
      "text": "Improve the attitude of an animal like a Diplomacy check: 1d20 + ranger level + Cha mod.",
      "activation": "passive",
      "effects": [],
      "enabledByDefault": true
    },
    {
      "id": "point-blank-shot",
      "name": "Point Blank Shot",
      "source": "feat",
      "text": "+1 on attack and damage rolls with ranged weapons at ranges up to 30 feet.",
      "sourceRef": "PHB p.98",
      "activation": "passive",
      "effects": [
        {
          "id": "pbs",
          "label": "Point Blank Shot",
          "trigger": "always",
          "when": {
            "kind": "all",
            "of": [
              {
                "kind": "attack.kind",
                "attackKind": "ranged"
              },
              {
                "kind": "toggle",
                "id": "within-30ft"
              }
            ]
          },
          "do": [
            {
              "kind": "bonus",
              "to": "attack",
              "value": 1,
              "bonusType": "untyped"
            },
            {
              "kind": "bonus",
              "to": "damage",
              "value": 1,
              "bonusType": "untyped"
            }
          ]
        }
      ],
      "enabledByDefault": true
    },
    {
      "id": "precise-shot",
      "name": "Precise Shot",
      "source": "feat",
      "text": "No -4 penalty for shooting into melee.",
      "sourceRef": "PHB p.98",
      "activation": "passive",
      "effects": [
        {
          "id": "n",
          "trigger": "always",
          "when": {
            "kind": "attack.kind",
            "attackKind": "ranged"
          },
          "do": [
            {
              "kind": "note",
              "text": "Precise Shot: no -4 for firing into melee."
            }
          ]
        }
      ],
      "enabledByDefault": true
    },
    {
      "id": "rapid-shot",
      "name": "Rapid Shot",
      "source": "feat",
      "text": "One extra ranged attack at your highest bonus during a full attack; all attacks that round take -2.",
      "sourceRef": "PHB p.99",
      "activation": "passive",
      "effects": [
        {
          "id": "mode",
          "trigger": "always",
          "when": {
            "kind": "always"
          },
          "do": [
            {
              "kind": "attackMode",
              "modeId": "rapid-shot",
              "label": "Rapid Shot",
              "base": "full",
              "extraAttacksAtTop": 1,
              "penalty": -2,
              "attackKind": "ranged"
            }
          ]
        }
      ],
      "enabledByDefault": true
    },
    {
      "id": "manyshot",
      "name": "Manyshot",
      "source": "feat",
      "text": "As a standard action fire two arrows at a single target within 30 ft with one attack roll at -4 (three arrows at BAB +11 for -6, four at +16 for -8). Precision damage applies once.",
      "sourceRef": "PHB p.97",
      "activation": "passive",
      "effects": [
        {
          "id": "mode",
          "trigger": "always",
          "when": {
            "kind": "always"
          },
          "do": [
            {
              "kind": "attackMode",
              "modeId": "manyshot",
              "label": "Manyshot (2 arrows)",
              "base": "single",
              "extraAttacksAtTop": 0,
              "penalty": -4,
              "attackKind": "ranged",
              "note": "Manyshot: one roll, both arrows hit or miss together; roll weapon damage twice, precision/extra dice once. Target within 30 ft."
            }
          ]
        }
      ],
      "enabledByDefault": true
    },
