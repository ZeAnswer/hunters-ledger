  "abilities": [
    {
      "id": "favored-enemy-1",
      "name": "Favored Enemy (1st)",
      "source": "class",
      "text": "+2 on Bluff, Listen, Sense Motive, Spot and Survival checks and weapon damage rolls against the chosen creature type. Increases by +2 at ranger levels 5, 10, 15, 20 (choose which favored enemy improves).",
      "sourceRef": "PHB p.47",
      "params": {
        "types": {
          "kind": "tags",
          "label": "Creature type",
          "category": "creatureType",
          "count": 1
        }
      },
      "activation": "passive",
      "effects": [
        {
          "id": "fe",
          "label": "Favored enemy",
          "trigger": "always",
          "when": {
            "kind": "param",
            "name": "types",
            "includesTargetTag": true
          },
          "do": [
            {
              "kind": "bonus",
              "to": "damage",
              "value": "favoredEnemyBonus1",
              "bonusType": "untyped"
            },
            {
              "kind": "bonus",
              "to": "skill.bluff",
              "value": "favoredEnemyBonus1",
              "bonusType": "untyped"
            },
            {
              "kind": "bonus",
              "to": "skill.listen",
              "value": "favoredEnemyBonus1",
              "bonusType": "untyped"
            },
            {
              "kind": "bonus",
              "to": "skill.sense-motive",
              "value": "favoredEnemyBonus1",
              "bonusType": "untyped"
            },
            {
              "kind": "bonus",
              "to": "skill.spot",
              "value": "favoredEnemyBonus1",
              "bonusType": "untyped"
            },
            {
              "kind": "bonus",
              "to": "skill.survival",
              "value": "favoredEnemyBonus1",
              "bonusType": "untyped"
            }
          ]
        }
      ],
      "enabledByDefault": true
    },
